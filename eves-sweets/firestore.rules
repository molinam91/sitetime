rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Menu + business settings: anyone can read (that's the whole public ordering page),
    // only the signed-in owner (see src/lib/auth.js) can write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /menu/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: customers (never signed in) create their own order and never touch anyone else's.
    // Only the owner can read the order list, edit, or delete.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Shared order-number counter: customers need to read and increment it when placing an
    // order (as part of the same Firestore transaction), so it can't require auth — but the
    // update rule below only lets it go up by exactly 1 at a time, so it can't be reset or
    // tampered with into something wildly wrong. Its value is just a display number, not
    // sensitive data, so a public read is fine.
    match /counters/{counterId} {
      allow read: if true;
      allow create: if request.resource.data.value == 1;
      allow update: if request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }
  }
}
